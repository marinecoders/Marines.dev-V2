---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Hero from '@components/sections/Hero.svelte';
import MaxWidthContainer from '@components/sections/MaxWidthContainer.svelte';
import CoderGrid from '@components/sections/CoderGrid.svelte';
import ButtonCustom from '@components/buttons/ButtonCustom.svelte';
import FooterFull from '@components/FooterFull.svelte';
import { displaySiteBanner } from '@components/stores.js';
import '../styles/global.css';

displaySiteBanner.set(true);

const communityEntries = await getCollection('community');
const coders = communityEntries.map((entry) => entry.data);
---

<Layout title="Community">
  <Hero
    title="OUR COMMUNITY"
    titleColor="yellow"
    description="The warfighters, innovators, and engineers who bring world-class software to the fight. Marines from every background united by code."
    descriptionClasses="w-full md:w-[500px] lg:w-[750px] font-light"
    backgroundImg="/images/miu-group-discussion.jpg"
    client:only="svelte"
  />
  <MaxWidthContainer>
    <div class="py-12 lg:py-20">
      <CoderGrid coders={coders} client:only="svelte" />
    </div>
    <div class="flex flex-col items-center justify-center pb-12 lg:pb-20 gap-6">
      <h2 class="font-bold tracking-wider text-center text-2xl md:text-3xl lg:text-[40px] bg-gradient-to-r from-mcswf-gold via-mcswf-gold-dark to-mcswf-gold text-transparent bg-clip-text [text-shadow:_0_2px_8px_rgb(255_199_85_/_0.2)] leading-tight">
        JOIN OUR COMMUNITY
      </h2>
      <p class="text-center text-base md:text-[21px] font-normal leading-relaxed tracking-wide text-slate-100 max-w-2xl">
        Connect with Marine Coders on Slack to collaborate, share ideas, and stay up to date.
      </p>
      <ButtonCustom
        color="yellow"
        size="xl"
        class="w-full md:w-64"
        link="https://join.slack.com/t/marinecoders/shared_invite/zt-3tz731don-xlY024rheMnub6_WfDXYUg"
        externalLink={true}
        client:only="svelte"
      >
        JOIN OUR SLACK
      </ButtonCustom>
    </div>
  </MaxWidthContainer>
  <FooterFull client:only="svelte" />
</Layout>
