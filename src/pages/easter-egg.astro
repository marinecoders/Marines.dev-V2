---
// Easter Egg page with 3D spinning coin
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Spinning 3D Coin - Easter Egg</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <style>
        /* Custom CSS for a dark, centered game/simulation aesthetic */
        body {
            margin: 0;
            overflow: hidden;
            background-color: #1a1a2e; /* Dark theme background */
            font-family: 'Inter', sans-serif;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }


        /* Ensure the canvas fills the remaining space */
        canvas {
            display: block;
        }

    </style>
</head>
<body>

    <script is:inline>
        // Global variables for Three.js scene elements
        let scene, camera, renderer, coin;

        // Wait for THREE.js to load
        function waitForThree() {
            if (typeof THREE !== 'undefined') {
                init();
                animate();
            } else {
                setTimeout(waitForThree, 100);
            }
        }

        // Initialize the Three.js scene
        function init() {
            // 1. Scene Setup
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x1a1a2e); // Match CSS background

            // 2. Camera Setup (Perspective Camera)
            // Field of View, Aspect Ratio, Near Clipping Plane, Far Clipping Plane
            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.z = 3;

            // 3. Renderer Setup
            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(window.devicePixelRatio);
            document.body.appendChild(renderer.domElement);

            // 4. Create the Coin
            createCoin();

            // 5. Add Lighting
            addLighting();

            // 6. Handle Window Resize
            window.addEventListener('resize', onWindowResize, false);
        }

        // Function to create the 3D coin geometry and materials
        function createCoin() {
            // Coin dimensions
            const radius = 1.0;
            const height = 0.1;
            const radialSegments = 64; // High segments for a smooth circle

            // Use local images from the public folder
            const HEADS_URL = '/front.png';
            const TAILS_URL = '/back.png';

            // Loader for images/textures
            const loader = new THREE.TextureLoader();

            // --- Load Textures ---
            const headsTexture = loader.load(HEADS_URL, undefined, undefined, (error) => {
                console.error("Error loading heads texture:", error);
            });
            const tailsTexture = loader.load(TAILS_URL, undefined, undefined, (error) => {
                console.error("Error loading tails texture:", error);
            });

            // --- Materials ---
            
            // Side Material (Darker Bronze/Brass for the milled edge) - reduced glare
            const sideMaterial = new THREE.MeshPhongMaterial({
                color: 0x996600, 
                specular: 0x333333, // much dimmer specular
                shininess: 10, // much less shiny
                flatShading: false
            });

            // Top (Heads) material using the loaded texture - reduced glare
            const headsMaterial = new THREE.MeshPhongMaterial({
                map: headsTexture, // Assign the loaded texture
                specular: 0x444444, // much dimmer specular
                shininess: 20, // much less shiny
                flatShading: false,
                // Ensure the image texture faces the correct way
                side: THREE.FrontSide
            });

            // Bottom (Tails) material using the loaded texture - reduced glare
            const tailsMaterial = new THREE.MeshPhongMaterial({
                map: tailsTexture, // Assign the loaded texture
                specular: 0x444444, // much dimmer specular
                shininess: 20, // much less shiny
                flatShading: false,
                // Ensure the image texture faces the correct way
                side: THREE.FrontSide
            });

            // Coin geometry (Cylinder is perfect for a coin)
            const geometry = new THREE.CylinderGeometry(radius, radius, height, radialSegments);

            // The geometry expects an array of 3 materials: [side, top, bottom]
            const materials = [sideMaterial, headsMaterial, tailsMaterial];

            coin = new THREE.Mesh(geometry, materials);
            scene.add(coin);

            // Initial rotation: 90 degrees (pi/2 radians) around the Z-axis.
            // This rotates the coin so its edge is facing the camera at the start.
            coin.rotation.z = Math.PI / 2; 
            coin.rotation.x = 0; 
        }

        // Function to add lights to the scene for visibility and shine
        function addLighting() {
            // Ambient Light (soft light from all directions) - reduced intensity
            const ambientLight = new THREE.AmbientLight(0x404040, 1.5); // much softer ambient light
            scene.add(ambientLight);

            // Directional Light (simulates sunlight or a strong source) - reduced intensity
            const directionalLight1 = new THREE.DirectionalLight(0xffffff, 1.2);
            directionalLight1.position.set(5, 5, 5).normalize();
            scene.add(directionalLight1);

            // Directional Light from the opposite side (for rim lighting) - reduced intensity
            const directionalLight2 = new THREE.DirectionalLight(0xffffff, 0.8);
            directionalLight2.position.set(-5, -5, -5).normalize();
            scene.add(directionalLight2);
        }

        // Animation loop to render the scene and update coin rotation
        function animate() {
            requestAnimationFrame(animate);

            if (coin) {
                // Now rotating on the Y-axis. Since the coin is initially tilted 90 degrees 
                // on Z, this makes it spin "left-to-right" while standing up.
                coin.rotation.y += 0.02; 
                
                // X-axis (flipping) rotation is now removed.
            }

            renderer.render(scene, camera);
        }

        // Handle browser window resizing
        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        // Start the application when the window loads
        window.onload = function () {
            waitForThree();
        };
    </script>
</body>
</html>
