---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/sections/Hero.svelte';
import FooterFull from '@components/FooterFull.svelte';
import MetricCard from '@components/cards/MetricCard.svelte';
import { getCollection, type CollectionEntry } from 'astro:content';
import { displaySiteBanner } from '@components/stores.js';
import { externalLinks } from '@content/externalLinks.js';
import '../../styles/global.css';

interface Props {
  entry: CollectionEntry<'products'>;
}

displaySiteBanner.set(false);

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((entry) => ({
    params: { product: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const metrics = entry.data.metrics || [];

// Use custom hero button text/link if provided, otherwise default to "REQUEST APP DEMO"
const heroButtonText = entry.data.heroButtonText || 'REQUEST APP DEMO';
const heroButtonLink = entry.data.heroButtonLink || `mailto:${externalLinks.marineCodersEmail}?subject=${externalLinks.marineCodersEmailSubject}`;
const isExternalLink = heroButtonLink.startsWith('http://') || heroButtonLink.startsWith('https://');
---

<Layout title={entry.data.product}>
  <Hero
    title={entry.data.product}
    description={entry.data.description}
    descriptionClasses="font-light lg:w-[1000px]"
    link={heroButtonLink}
    linkText={heroButtonText}
    externalLink={isExternalLink}
    backgroundImg={entry.data.background.src}
    client:only="svelte"
  />
  <div class="relative z-20 max-w-screen-xl px-4 py-8 mx-auto lg:py-12 lg:px-6">
    <img
      class="w-full rounded-xl border-8 border-white/20 shadow-2xl shadow-black/60"
      src="/images/hlz-image.png"
      alt="HLZ Plugin screenshot"
    />
  </div>

  <div class="relative z-20">
    <FooterFull client:only="svelte" />
  </div>
</Layout>
